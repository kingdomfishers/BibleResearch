{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bibleresearch-corpus",
  "main": "./scripts/corpus-worker.mjs",
  "minify": true,
  "compatibility_date": "2026-11-02",
  "preview_urls": false,
  "assets": {
    "directory": "./.artifacts-r12/staging-bundle",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "version_metadata": {
    "binding": "WORKER_VERSION"
  },
  "vars": {
    "R12_RELEASE_ID": "r13-discovery-1",
    "R12_ASSET_SHA256": "366e3acdd2debbefc1de234ef39b684271b6c2cdca3cdfce69dfc9b4b6d49b6b",
    "R12_SOURCE_COMMIT": "838da3d84e1bcdb19ab9e5fff3dd1fb591474b09"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
