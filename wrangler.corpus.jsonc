{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bibleresearch-corpus",
  "main": "./scripts/corpus-worker.mjs",
  "minify": true,
  "compatibility_date": "2026-11-02",
  "preview_urls": false,
  "assets": {
    "directory": "./.artifacts-r12/staging-bundle",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "version_metadata": {
    "binding": "WORKER_VERSION"
  },
  "vars": {
    "R12_RELEASE_ID": "r14-v4-discovery-1",
    "R12_ASSET_SHA256": "5c60e7d08af466e090f9e3fd45eb39bf19a647994fe3e25f4cef0af6333ed52f",
    "R12_SOURCE_COMMIT": "1354103881e01616d7a5ca5fe9c3223c5b0254b2"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
