{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bibleresearch-corpus",
  "main": "./scripts/corpus-worker.mjs",
  "minify": true,
  "compatibility_date": "2026-11-02",
  "preview_urls": false,
  "assets": {
    "directory": "./.artifacts-r12/staging-bundle",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "version_metadata": {
    "binding": "WORKER_VERSION"
  },
  "vars": {
    "R12_RELEASE_ID": "r13-discovery-3",
    "R12_ASSET_SHA256": "fb41be32c11135a5aacdac7101907b2a7ba0878472742db4160518986d9fd422",
    "R12_SOURCE_COMMIT": "68311c67daa7a33516025f3f079d8aac1283744e"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
