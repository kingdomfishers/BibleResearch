{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bibleresearch-corpus",
  "main": "./scripts/corpus-worker.mjs",
  "minify": true,
  "compatibility_date": "2026-11-02",
  "preview_urls": false,
  "assets": {
    "directory": "./.artifacts-r12/staging-bundle",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "version_metadata": {
    "binding": "WORKER_VERSION"
  },
  "vars": {
    "R12_RELEASE_ID": "r12-discovery-2",
    "R12_ASSET_SHA256": "7a08727be4d841e4aded1f0aeb5300c9d79e32769d30ba1968726d413f630a11",
    "R12_SOURCE_COMMIT": "d9940058651c83befa168a2f31e60fca0c691414"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
