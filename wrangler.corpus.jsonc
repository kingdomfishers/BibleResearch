{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bibleresearch-corpus",
  "main": "./scripts/corpus-worker.mjs",
  "compatibility_date": "2026-11-02",
  "preview_urls": false,
  "assets": {
    "directory": "./.artifacts-r12/staging-bundle",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "version_metadata": {
    "binding": "WORKER_VERSION"
  },
  "vars": {
    "R12_RELEASE_ID": "r12-discovery-1",
    "R12_ASSET_SHA256": "c23272125b34f179237e1c61381ec0b3b92e282f6ae496194bf994",
    "R12_SOURCE_COMMIT": "712d3627b881b137fe11da6fc97d0871600c568c"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
